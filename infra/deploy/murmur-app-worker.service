[Unit]
Description=Murmur — official App worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=murmur
WorkingDirectory=/opt/murmur
EnvironmentFile=/opt/murmur/.env
ExecStart=/opt/murmur/.venv/bin/murmur app-worker

Restart=always
RestartSec=5

# Cap a leak so the OOM killer never picks a host-wide victim; the VPS has ~4G.
MemoryMax=512M

StandardOutput=append:/opt/murmur/logs/murmur_app_worker.log
StandardError=append:/opt/murmur/logs/murmur_app_worker.log
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/murmur

[Install]
WantedBy=multi-user.target
