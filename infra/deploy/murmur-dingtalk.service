[Unit]
Description=Murmur — DingTalk test bot
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/murmur/.env.test-bots
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=murmur
WorkingDirectory=/opt/murmur
EnvironmentFile=/opt/murmur/.env.test-bots
ExecStart=/opt/murmur/.venv/bin/murmur dingtalk

Restart=always
RestartSec=10

# 看板按文件读取日志；部署包里的 logrotate 负责轮转。
StandardOutput=append:/opt/murmur/test/logs/murmur_dingtalk.log
StandardError=append:/opt/murmur/test/logs/murmur_dingtalk.log
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/murmur/test

[Install]
WantedBy=multi-user.target
