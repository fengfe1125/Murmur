MURMUR_API_BASE_URL = http:/$()/127.0.0.1:8766
MURMUR_DEVELOPMENT_TOKEN =
// Audius is off unless a registration is supplied locally.  Declared
// here so an unconfigured build resolves the key to empty rather than
// shipping the literal variable name in its bundle.
MURMUR_AUDIUS_API_KEY =
MURMUR_AUDIUS_REDIRECT_URI = murmur-audius:/$()/oauth/callback
#include? "Debug.local.xcconfig"

// Custom keys only; GENERATE_INFOPLIST_FILE merges Apple's on top.
INFOPLIST_FILE = MurmurApp/Config/Info.plist
