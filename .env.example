# 复制成 .env 再填。.env 已在 .gitignore 里。

# 模型网关。二选一：OpenCode（Go 订阅）或任何支持图片输入的 OpenAI 兼容网关。
# 可运行 ./scripts/setup-murmur.sh 交互式生成 .env；密钥不会写入本文件。
# OpenCode key 在 https://opencode.ai/zen 后台拿：
OPENCODE_API_KEY=
# 自定义网关则填这项，并把 MURMUR_BASE_URL 改成对应地址：
MURMUR_API_KEY=

# Telegram bot token，找 @BotFather 要
TELEGRAM_BOT_TOKEN=

# 只允许这些 chat 用你的额度。留空 = 谁找到 bot 都能用。
# 对 bot 发 /start 会告诉你自己的 chat id。
MURMUR_ALLOWED_CHAT_IDS=

# 钉钉（Stream 模式，不需要公网 IP）
# open-dev.dingtalk.com → 企业内部应用 → 凭据与基础信息
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 允许使用机器人的 userId，逗号分隔。留空 = 企业里谁都能用。
# 同一个人在多个组织里有不同 id 时，用 | 连起来表示是同一人（共享记忆）：
#   DINGTALK_ALLOWED_USERS=aaa|bbb,ccc     ← aaa 和 bbb 是同一人，ccc 是另一人
DINGTALK_ALLOWED_USERS=

# 谁会收到主动消息（一天 10-15 条）。留空 = 只给上面第一个人发。
# 白名单是"允许使用"，这个是"允许被打扰"，别混。
DINGTALK_INITIATIVE_USERS=

# 微信（腾讯官方 ClawBot 通道，2026-03 开放）
# token 不用填：先扫码登录一次，Murmur 会自己去 ~/.openclaw 里读。
#   npx -y @tencent-weixin/openclaw-weixin-cli install
#   openclaw channels login --channel openclaw-weixin
# 登录完一定要把插件关掉，否则 OpenClaw 网关会和 Murmur 抢消息：
#   openclaw config set plugins.entries.openclaw-weixin.enabled false
#   openclaw gateway restart
WECHAT_TOKEN=
# 登录了多个微信号时用来指定是哪个，只有一个就不用填
WECHAT_ACCOUNT_ID=
# 允许使用的 openId（形如 xxxx@im.wechat）。留空 = 任何加了你的人都能用你的额度。
# 第一次跑起来后，对方发一条消息，日志里就会打印出他的 openId。
WECHAT_ALLOWED_USERS=

# 微信主动消息。**默认关闭，建议保持关闭。**
# 微信官方的 sendMessage 是为"被动回复"设计的：要带上收到消息时的
# context_token。主动发只能复用上次存下来的那个，属于官方没承诺的用法，
# 腾讯随时可以关。加上服务端限速 7 条/5 分钟，这条路能走但不牢靠。
# Telegram 和钉钉没有这个限制，主动消息优先走那两边。
WECHAT_INITIATIVE=

# QQ（腾讯官方机器人）。去 https://q.qq.com/ 创建，复制 AppID / AppSecret。
# 这是独立的机器人账号，不是扫码挂个人 QQ。
QQ_APP_ID=
QQ_CLIENT_SECRET=
# 允许使用的 openId。留空 = 任何加了这个机器人的人都能用你的额度。
# 对方发一条之后，日志里会打印 openId。
QQ_ALLOWED_USERS=
# 未过审的机器人只在沙箱里收得到消息：QQ_SANDBOX=1
QQ_SANDBOX=
QQ_INITIATIVE=1

# ── 以下都有默认值，不用改也能跑 ──

# Go 订阅走这个；换成 https://opencode.ai/zen/v1 是完整 Zen 目录（按量计费）
MURMUR_BASE_URL=https://opencode.ai/zen/go/v1

# 默认 qwen3.7-plus。备选：
#   mimo-v2.5    最便宜（约 1/3 价），回应偏短
#   kimi-k2.6    语气最像人，但贵约 20 倍
#   qwen3.8-max  更强，输出 token 多、慢
MURMUR_MODEL=qwen3.7-plus

# 记忆整理（dossiers/*.md 的合并重写）用的模型。这是调用量最大的
# prompt，便宜模型完全够。留空 = 跟着 MURMUR_MODEL 走。
# 建议：MURMUR_MEMORY_MODEL=mimo-v2.5
MURMUR_MEMORY_MODEL=

MURMUR_DB=./murmur.db
MURMUR_TZ=Asia/Shanghai

# 日志目录。默认是数据库旁边的 logs/（macOS 会定期清 /tmp，不放那边）。
MURMUR_LOGDIR=

# 看板访问令牌。看板默认只绑 127.0.0.1；要用 --host 0.0.0.0 开放出去的话
# 务必先设这个，否则聊天原文和记忆文件在局域网里裸奔。
# 访问时带 Header X-Murmur-Token（或 URL 加 ?token=...）。
MURMUR_WEB_TOKEN=
