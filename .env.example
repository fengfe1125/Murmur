# 复制成 .env 再填。.env 已在 .gitignore 里。

# 正式渠道策略。验收期保持 transition；真机验收完成后改成 app_only。
# 旧平台全部是测试 Bot：即使有平台凭据，也必须显式开启才可能启动。
MURMUR_CHANNEL_MODE=transition
MURMUR_ENABLE_TEST_BOTS=0

# 陌生平台用户默认不能自动进入名册。只允许明确白名单中的测试账号。
MURMUR_AUTO_ENROLL=0

# 模型网关。二选一：OpenCode（Go 订阅）或任何支持图片输入的 OpenAI 兼容网关。
# 可运行 ./scripts/setup-murmur.sh 交互式生成 .env；密钥不会写入本文件。
# OpenCode key 在 https://opencode.ai/zen 后台拿：
OPENCODE_API_KEY=
# 自定义网关则填这项，并把 MURMUR_BASE_URL 改成对应地址：
MURMUR_API_KEY=

# 平台测试凭据不属于生产环境。需要回归 Telegram / 钉钉 / 微信 / QQ 时，
# 复制 deploy/test-bots.env.example 为 .env.test-bots，并使用独立 DB 与日志。

# ── 以下都有默认值，不用改也能跑 ──

# Go 订阅走这个；换成 https://opencode.ai/zen/v1 是完整 Zen 目录（按量计费）
MURMUR_BASE_URL=https://opencode.ai/zen/go/v1

# 默认 qwen3.7-plus。备选：
#   mimo-v2.5    最便宜（约 1/3 价），回应偏短
#   kimi-k2.6    语气最像人，但贵约 20 倍
#   qwen3.8-max  更强，输出 token 多、慢
MURMUR_MODEL=qwen3.7-plus

# 记忆整理（dossiers/*.md 的合并重写）用的模型。这是调用量最大的
# prompt，便宜模型完全够。留空 = 跟着 MURMUR_MODEL 走。
# 建议：MURMUR_MEMORY_MODEL=mimo-v2.5
MURMUR_MEMORY_MODEL=

# 降级备案（2026-08-16 OpenCode 网关 Qwen 上游整体 503 之后加的）：
# 主模型抛网关错误或吐不出 JSON 时，自动换这个模型重试一次。
# deepseek-v4-flash 不支持 response_format，降级调用会自动去掉
# json_schema，靠提示词里的「只返回 JSON」约束输出。
MURMUR_FALLBACK_MODEL=deepseek-v4-flash

# 带图消息走这个多模态模型（kimi-k2.6 视觉不可靠，mimo-v2.5 便宜且能看图）。
# 它同样不支持 json_schema；mimo 也挂掉时退回上面的降级模型、不带图重试。
MURMUR_IMAGE_MODEL=mimo-v2.5

# 主模型是否支持 json_schema 响应格式。OpenCode 网关实测 qwen/kimi 系支持，
# glm/deepseek 系会 400 或把 token 全烧进思考——用这两家时设 0，
# 靠 SYSTEM 提示词里的「只返回 JSON」约束（降级调用始终不带 schema）。
MURMUR_JSON_SCHEMA=1

# DeepSeek 直连（不走 OpenCode 网关）的整套配方，2026-08 实测：
#   MURMUR_BASE_URL=https://api.deepseek.com/beta   # 注意是 /beta，prefix 只在 beta 上有
#   MURMUR_API_KEY=sk-...                           # DeepSeek 后台的 key
#   MURMUR_MODEL=deepseek-v4-flash
#   MURMUR_IMAGE_MODEL=deepseek-v4-flash-vision-exp  # 读图 2 秒级，JSON 纪律好
#   MURMUR_FALLBACK_MODEL=                           # 直连就一家，留空
#   MURMUR_JSON_SCHEMA=0
#   MURMUR_JSON_PREFIX=1
# JSON_PREFIX 用 beta 端点的 assistant prefix 把回复首字符钉成 "{"——
# deepseek 直连不吃「只返回 JSON」的提示词，但吃 prefix。
MURMUR_JSON_PREFIX=0

# 对话采样参数（只作用于聊天回复，读图/记忆整理不受影响）。
# 留空 = 请求不带这个参数，用服务商默认值。
# 回复复读明显（开头总是一个句式）时，先试 presence_penalty 0.3 左右，
# 比往提示词里堆「不要重复」管用；temperature 不建议超过 1.2，
# 越高 JSON 纪律越差。
MURMUR_TEMPERATURE=
MURMUR_PRESENCE_PENALTY=

# 回复质量 P1 分阶段开关。P0 在真实端点连续稳定 24–48 小时后，
# 按 OPEN_LOOPS → REPLY_DIRECTIVES → PROACTIVE_MATERIALS → AFFECT 的顺序
# 一次只开一个；默认全关，方便任一阶段独立回滚。
MURMUR_OPEN_LOOPS=0
MURMUR_REPLY_DIRECTIVES=0
MURMUR_PROACTIVE_MATERIALS=0
MURMUR_AFFECT=0

# ── 正式 App API ──

# 生产必须是 HTTPS 正式域名；本地开发可用 http://127.0.0.1:8766。
MURMUR_APP_BASE_URL=https://app.example.com
MURMUR_APP_BUNDLE_ID=com.sakura.Murmur
MURMUR_APP_TEAM_ID=
# 留空时自动使用 TEAM_ID.BUNDLE_ID；也可显式填写完整 App ID。
MURMUR_APP_ID=

# production 会拒绝任何开发绕过，并要求 App ID / Team ID / HTTPS。
# 没有 Apple Developer 账号时，只能在隔离开发环境显式改为 development，
# 同时打开 ALLOW 并提供至少 24 字符的随机 token；绝不能用于 Release/生产。
MURMUR_APP_ATTEST_MODE=production
MURMUR_APP_ALLOW_DEVELOPMENT=0
MURMUR_APP_DEVELOPMENT_TOKEN=
# 通常留空，使用服务内置的 Apple App Attest Root CA。
MURMUR_APP_ATTEST_ROOT_CA=

# App 作业/身份表与 Murmur 记忆可放同一 SQLite，也可分别指定。
MURMUR_APP_DB=./murmur.db
MURMUR_APP_MEMORY_DB=./murmur.db
MURMUR_APP_DATA_ROOT=.
MURMUR_APP_TEMP_DIR=./app-uploads
MURMUR_APP_TIMEZONE=Asia/Shanghai

# APNs token 签名密钥只放在服务器 secrets 目录，AuthKey_*.p8 已被 Git 忽略。
MURMUR_APP_APNS_KEY_PATH=
MURMUR_APP_APNS_KEY_ID=
MURMUR_APP_APNS_TEAM_ID=
MURMUR_APP_APNS_TOPIC=com.sakura.Murmur
MURMUR_APP_APNS_ENVIRONMENT=production

# Android 推送（FCM HTTP v1）。留空则只有 iOS 能收到主动消息，
# Android 设备的投递会一直挂着重试，不会被判死。
# service account JSON 同样只放服务器 secrets 目录，不要进 Git。
MURMUR_APP_FCM_PROJECT_ID=
MURMUR_APP_FCM_SERVICE_ACCOUNT_PATH=

# ── Android 客户端认证（Key Attestation）──
# 开了才会接受 Android 注册；iOS 不受影响。
MURMUR_APP_ANDROID_ENABLED=0
MURMUR_APP_ANDROID_PACKAGE=com.sakura.murmur
# release 签名证书的 SHA-256，逗号分隔（keytool -list -v 里的 SHA256 那行）。
# 这是 Android 版的 app_id 校验：别人拿到 APK 重签名后就对不上。
MURMUR_APP_ANDROID_SIGNING_DIGESTS=
# Google 硬件认证根证书，PEM。故意不内嵌：请自己从
# https://developer.android.com/privacy-and-security/security-key-attestation
# 取回并核对后放到服务器 secrets 目录。
MURMUR_APP_ATTEST_GOOGLE_ROOT_CA=
# 取不到 Google 吊销列表时是否放行。默认 0（拒绝注册）。
MURMUR_APP_ATTEST_REVOCATION_FAIL_OPEN=0

# 25MB 图片 + multipart 余量；服务端还会按用户限流。
MURMUR_APP_MAX_IMAGE_BYTES=26214400
MURMUR_APP_MAX_BODY_BYTES=27262976
MURMUR_APP_MAX_JSON_BODY_BYTES=262144
MURMUR_APP_MAX_CONCURRENT_UPLOADS=2
MURMUR_APP_BODY_READ_TIMEOUT_SECONDS=180
MURMUR_APP_BODY_IDLE_TIMEOUT_SECONDS=15
MURMUR_APP_MIN_BODY_BYTES_PER_SECOND=16384
MURMUR_APP_BODY_SPEED_GRACE_SECONDS=10
MURMUR_APP_BODY_GATE_TIMEOUT_SECONDS=1
MURMUR_APP_MAX_IMAGE_PIXELS=80000000
MURMUR_APP_MAX_NOTE_CHARS=2000
# 按来源 IP 计。一次 App Attest 调用要两个请求（挑战 + 正文），一条消息
# 至少四个，事件流重连还要再加——正常对话就能撑到几十。设太低会把自己
# 的用户挡在门外。
MURMUR_APP_RATE_LIMIT_PER_MINUTE=120
MURMUR_APP_RATE_LIMIT_MAX_KEYS=4096
MURMUR_APP_EVENT_TTL_HOURS=24
# 每轮推送投递的最长耗时；超时的条目留在队列里等下一轮。
MURMUR_APP_PUSH_DELIVERY_BUDGET_SECONDS=30

MURMUR_DB=./murmur.db
MURMUR_TZ=Asia/Shanghai

# 日志目录。默认是数据库旁边的 logs/（macOS 会定期清 /tmp，不放那边）。
MURMUR_LOGDIR=

# 看板访问令牌。看板默认只绑 127.0.0.1；要用 --host 0.0.0.0 开放出去的话
# 务必先设这个，否则聊天原文和记忆文件在局域网里裸奔。
# 访问时带 Header X-Murmur-Token（或 URL 加 ?token=...）。
MURMUR_WEB_TOKEN=
