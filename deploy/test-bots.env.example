# Copy to /opt/murmur/.env.test-bots and chmod 600 only on a test host.
# Never point these values at the production App database or log directory.

MURMUR_CHANNEL_MODE=transition
MURMUR_ENABLE_TEST_BOTS=1
MURMUR_AUTO_ENROLL=0

MURMUR_DB=/opt/murmur/test/murmur.db
MURMUR_LOGDIR=/opt/murmur/test/logs
MURMUR_TZ=Asia/Shanghai

OPENCODE_API_KEY=
MURMUR_API_KEY=
MURMUR_BASE_URL=https://opencode.ai/zen/go/v1
MURMUR_MODEL=qwen3.7-plus

# Fill only the test platforms you actually use. Keep every allowlist explicit.
TELEGRAM_BOT_TOKEN=
MURMUR_ALLOWED_CHAT_IDS=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=
DINGTALK_INITIATIVE_USERS=
WECHAT_TOKEN=
WECHAT_ACCOUNT_ID=
WECHAT_ALLOWED_USERS=
WECHAT_INITIATIVE=0
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_ALLOWED_USERS=
QQ_INITIATIVE=0
QQ_SANDBOX=1
