[Unit]
Description=Murmur — Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=murmur
WorkingDirectory=/opt/murmur
EnvironmentFile=/opt/murmur/.env
ExecStart=/opt/murmur/.venv/bin/murmur bot

# 挂了就重连。网络抖动、网关 5xx、进程崩溃都靠这个爬起来。
Restart=always
RestartSec=10
# 别在启动失败时无限快速重启把日志刷爆
StartLimitIntervalSec=300
StartLimitBurst=10

# 看板按文件读取日志；部署包里的 logrotate 负责轮转。
StandardOutput=append:/opt/murmur/logs/murmur_bot.log
StandardError=append:/opt/murmur/logs/murmur_bot.log
UMask=0077

# 基本加固：.env 里有活的 key
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/murmur

[Install]
WantedBy=multi-user.target
